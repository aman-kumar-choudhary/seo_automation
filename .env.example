SEO_DATABASE_PATH=data/innovions.db
SEO_DASHBOARD_HOST=127.0.0.1
SEO_DASHBOARD_PORT=8765
SEO_HEADLESS=false
SEO_SLOW_MO=300
SEO_DRY_RUN=true
SEO_MANUAL_APPROVAL=true
SEO_KEEP_BROWSER_OPEN=false
# Optional: authorized Moz API endpoint/token. Metrics are never guessed.
MOZ_API_URL=
MOZ_API_TOKEN=
# Optional authorized search provider. It must return a JSON object with `results`,
# each result containing `name`, `url`, and optionally `registration_url`,
# `submission_url`, and `terms_url`.
SEO_SEARCH_API_URL=
SEO_SEARCH_API_TOKEN=
SEO_DISCOVERY_MAX_RESULTS=50
